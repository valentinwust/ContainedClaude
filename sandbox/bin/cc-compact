#!/usr/bin/env python3
"""cc-compact [WHAT TO KEEP]

Has this conversation compacted when your current turn ends, once a context notice has offered it (main session
only). Write down what matters first; WHAT TO KEEP goes to the summary. End your reply after the call; you are
prompted to continue after the compaction. Run it as a command of its own, not inside a script or `bash -c`.
"""
# This script only states the wish and prints that nothing is scheduled. The compaction mod
# (sandbox/mods/compaction/hooks/register.ts) sees the Bash call, refuses it in a subagent and below the offer's
# size, and otherwise puts "compaction is scheduled" in that line's place. So a call it can't see (inside a
# script, `bash -c`, a function) says the truth by itself.
import sys

if sys.argv[1:2] in (["-h"], ["--help"]):
    print(__doc__.strip())
    sys.exit(0)
keep = " ".join(" ".join(sys.argv[1:]).split())     # one line: the mod reads to its end
# the mod replaces this line (UNSEEN in sandbox/mods/compaction/hooks/register.ts)
print("cc-compact: nothing scheduled: containedclaude did not see this call. Run cc-compact as a command of its "
      "own (not inside a script or bash -c).")
if keep:
    print("Keep: " + keep)          # the mod reads it from here (KEEP in register.ts)
